---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CapabilitySection from '../components/CapabilitySection.astro';
import RecognitionSection from '../components/RecognitionSection.astro';
import TributeCallout from '../components/TributeCallout.astro';
import ClientLogos from '../components/ClientLogos.astro';
import heroImage from '../assets/hero/train.jpg';
import aboutImage from '../assets/photos/home-about.jpg';
import capabilityImage from '../assets/photos/home-capability.jpg';

const services = [
  {
    icon: 'rail',
    title: 'Rail contracting',
    text: 'Highly experienced in all aspects of rail contracting, including all forms of rail welding.',
    href: '/rail/',
    cta: 'Learn more',
  },
  {
    icon: 'worker',
    title: 'Labour & equipment hire',
    text: 'Over 15 years of labour hire experience, we find the right people based on your requirements. We specialise in Indigenous engagement and support.',
    href: '/rail-labour-equipment-hire/',
    cta: 'Learn more',
  },
  {
    icon: 'tools',
    title: 'Tradie hub',
    text: 'We are now able to offer a range of trade services, including electrical, carpentry and more.',
    href: '/contact-us/',
    cta: 'Enquire now',
  },
  {
    icon: 'excavator',
    title: 'Civil contracting',
    text: 'A broad range of civil contracting services and capabilities, either directly or through one of our JVs or business alliances.',
    href: '/civil-contracting/',
    cta: 'Learn more',
  },
] as const;

const highlights = [
  { icon: 'train', label: 'Rail & civil expertise' },
  { icon: 'australia', label: 'Remote WA capability' },
  { icon: 'gear', label: 'Integrated project delivery' },
] as const;
---
<Base title="Home">
  <!-- Hero -->
  <section class="relative isolate flex min-h-140 items-center overflow-hidden bg-navy-950 lg:min-h-190" aria-label="Introduction">
    <Image
      src={heroImage}
      alt=""
      widths={[768, 1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-20 size-full object-cover object-[70%_60%]"
    />
    <div class="absolute inset-0 -z-10 bg-linear-to-r from-navy-950/90 via-navy-950/45 to-transparent"></div>
    <div class="absolute inset-0 -z-10 bg-linear-to-t from-navy-950/60 via-transparent to-transparent"></div>

    <!-- Dot-art motif -->
    <svg class="pointer-events-none absolute -top-20 -right-20 hidden w-72 md:block" viewBox="0 0 400 400" fill="none" stroke-linecap="round" aria-hidden="true">
      <circle cx="200" cy="200" r="22" stroke="var(--color-brand-light)" stroke-width="10" />
      <circle cx="200" cy="200" r="58" stroke="var(--color-gold)" stroke-width="7" stroke-dasharray="0 16" />
      <circle cx="200" cy="200" r="88" stroke="var(--color-bush)" stroke-width="6" />
      <circle cx="200" cy="200" r="116" stroke="var(--color-brand-light)" stroke-width="6" stroke-dasharray="0 15" />
      <circle cx="200" cy="200" r="144" stroke="var(--color-gold)" stroke-width="5" stroke-dasharray="40 14" />
      <circle cx="200" cy="200" r="172" stroke="var(--color-bush)" stroke-width="5" stroke-dasharray="0 14" />
    </svg>
    <svg class="pointer-events-none absolute top-36 -right-44 hidden w-72 opacity-70 lg:block" viewBox="0 0 400 400" fill="none" stroke-linecap="round" aria-hidden="true">
      <circle cx="200" cy="200" r="70" stroke="var(--color-bush)" stroke-width="7" />
      <circle cx="200" cy="200" r="100" stroke="var(--color-brand-light)" stroke-width="7" />
      <circle cx="200" cy="200" r="130" stroke="var(--color-gold)" stroke-width="6" stroke-opacity=".7" />
      <circle cx="200" cy="200" r="160" stroke="var(--color-gold)" stroke-width="6" stroke-dasharray="0 15" />
    </svg>

    <div class="container-x py-20 lg:pb-32">
      <p class="font-display text-sm font-semibold tracking-[0.35em] text-gold uppercase sm:text-base">Contracting &amp; rail services</p>
      <h1 class="mt-5 max-w-4xl leading-[0.9] text-white">
        <span class="block text-5xl sm:text-6xl lg:text-7xl">Keeping your resources</span>
        <span class="block text-6xl font-bold uppercase sm:text-7xl lg:text-8xl">On track.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-white/85 sm:text-xl">
        Rail, civil, electrical, mechanical and modular contracting across Perth, the Pilbara and remote Western Australia.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="#services" class="inline-flex items-center gap-2 rounded-full bg-gold px-8 py-3.5 font-semibold text-navy-950 transition-colors hover:bg-gold-light">
          Explore our services <Icon name="arrow" class="size-4" />
        </a>
        <a href="/contact-us/" class="inline-flex items-center rounded-full border-2 border-white/90 px-8 py-3 font-semibold text-white transition-colors hover:bg-white hover:text-navy-900">
          Talk to our team
        </a>
      </div>
      <ul class="mt-14 flex flex-col gap-5 text-white/90 sm:flex-row sm:flex-wrap sm:items-center sm:gap-0">
        {highlights.map((h, i) => (
          <li class:list={['flex items-center gap-3', i > 0 && 'sm:ml-8 sm:border-l sm:border-white/30 sm:pl-8']}>
            <Icon name={h.icon} class="size-8 shrink-0 text-gold" />
            {h.label}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="relative z-10 -mt-1 scroll-mt-24 bg-white pb-20" aria-label="Our services">
    <div class="container-x">
      <ul class="grid gap-px overflow-hidden bg-navy-900/10 shadow-xl sm:grid-cols-2 lg:-mt-16 lg:grid-cols-4">
        {services.map((s) => (
          <li class="group relative flex flex-col bg-white p-8 transition-colors hover:bg-navy-900">
            <span class="flex size-14 items-center justify-center rounded-sm bg-brand/10 text-brand transition-colors group-hover:bg-ochre group-hover:text-white">
              <Icon name={s.icon} class="size-8" />
            </span>
            <h2 class="mt-6 text-2xl uppercase transition-colors group-hover:text-white">{s.title}</h2>
            <p class="mt-3 flex-1 leading-relaxed text-ink/75 transition-colors group-hover:text-white/75">{s.text}</p>
            <a href={s.href} class="mt-6 inline-flex items-center gap-2 font-display font-semibold tracking-[0.12em] text-ochre uppercase after:absolute after:inset-0 group-hover:text-white">
              {s.cta}<span class="sr-only"> about {s.title.toLowerCase()}</span> <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-1" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- About -->
  <section class="pb-20 sm:pb-28" aria-labelledby="about-heading">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="eyebrow">“Bridging gaps, making tracks”</p>
        <h2 id="about-heading" class="section-title mt-2">NorWest Contracting &amp; Rail</h2>
        <div class="prose-nwcr mt-6 text-lg">
          <p class="font-medium text-navy-800!">NorWest Contracting and Rail is a Pilbara Indigenous Traditional Owner company.</p>
          <p>
            Melanie was born and raised in Port Hedland, but her family ties are to the greater Pilbara. Mel graduated Year 12 in the
            Pilbara, awarded Indigenous Student of the Year, and then transitioned into work life that has, over time, driven her to
            run several of her own companies.
          </p>
          <p>
            In 2011 there was a program run by BHP to help Indigenous peoples bring their business ideas to life, and that’s how the
            crazy journey started. With the ongoing support and mentoring of that program we were able to build NWCR slowly but
            carefully, while sticking to our business plan and vision for change. Today our teams are spread out across Australia in
            multiple industries such as oil and gas, iron ore and government projects.
          </p>
          <p>
            At NWCR we recognise that our people are the key to our success. The contribution by Indigenous peoples to the rail
            industry, including construction in the 1960s, saw achievements that are still recognised today. NWCR’s vision is to
            create sustainable employment opportunities for everyone going forward, which requires commitment from multiple parties.
            We are here to create a positive engagement experience.
          </p>
          <p class="font-display text-2xl font-semibold tracking-wide text-ochre! uppercase">Are you ready to be a pillar for change?</p>
        </div>
        <a href="/about-us/" class="btn-navy mt-4">Learn more<span class="sr-only"> about NWCR</span> <Icon name="arrow" class="size-4" /></a>
      </div>
      <Image src={aboutImage} alt="NWCR rail crews working on track in the Pilbara" widths={[480, 720, 960]} sizes="(min-width: 1024px) 50vw, 100vw" class="w-full" />
    </div>
  </section>

  <CapabilitySection image={capabilityImage} />

  <RecognitionSection>
    <TributeCallout />
  </RecognitionSection>

  <ClientLogos />
</Base>
