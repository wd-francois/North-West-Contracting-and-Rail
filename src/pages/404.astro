---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="container-x flex flex-col items-start py-28 sm:py-36">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-2 text-5xl uppercase sm:text-6xl">This track doesn’t go anywhere</h1>
    <p class="mt-6 max-w-xl text-lg text-ink/75">The page you’re looking for may have moved. Try the home page or get in touch with our team.</p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a href="/" class="btn-primary">Back to home</a>
      <a href="/contact-us/" class="btn-navy">Contact us</a>
    </div>
  </section>
</Base>
