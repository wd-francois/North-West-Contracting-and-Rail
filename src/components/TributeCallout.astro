---
import Icon from './Icon.astro';
---
<div class="relative overflow-hidden rounded-sm bg-ochre p-8 text-white shadow-2xl sm:p-10">
  <Icon name="heart" class="absolute -right-6 -bottom-6 size-40 text-white/10" />
  <p class="eyebrow text-white">Supporting our people</p>
  <h2 class="mt-2 text-4xl text-white uppercase">Indigenous tribute</h2>
  <p class="mt-4 max-w-md text-lg leading-relaxed text-white">
    NWCR has an accredited Indigenous mentor and life coach that can assist with support programs.
  </p>
  <a href="/indigenous-tribute/" class="btn mt-8 bg-white text-ochre-dark hover:bg-navy-900 hover:text-white">
    Learn more<span class="sr-only"> about our Indigenous tribute</span> <Icon name="arrow" class="size-4" />
  </a>
</div>
