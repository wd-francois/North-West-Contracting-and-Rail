---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Let’s keep your project on track',
  text = 'Our team often works in remote areas of the Pilbara. Email is the best way to reach us, and we’ll get back to you as soon as possible.',
} = Astro.props;
---
<section class="bg-navy-900">
  <div class="container-x flex flex-col items-start justify-between gap-8 py-14 lg:flex-row lg:items-center">
    <div class="max-w-2xl">
      <h2 class="text-3xl text-white uppercase sm:text-4xl">{title}</h2>
      <p class="mt-3 text-white/75">{text}</p>
    </div>
    <div class="flex flex-wrap gap-4">
      <a href="/contact-us/" class="btn-primary">Talk to us <Icon name="arrow" class="size-4" /></a>
      <a href={site.phoneHref} class="btn-outline"><Icon name="phone" class="size-4" /> {site.phone}</a>
    </div>
  </div>
</section>
