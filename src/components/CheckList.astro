---
import Icon from './Icon.astro';

interface Props {
  items: string[];
  columns?: 1 | 2;
  dark?: boolean;
}
const { items, columns = 1, dark = false } = Astro.props;
---
<ul class:list={['grid gap-x-8 gap-y-2.5', columns === 2 && 'sm:grid-cols-2']}>
  {items.map((item) => (
    <li class="flex gap-3">
      <span class:list={['mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full', dark ? 'bg-ochre/90 text-white' : 'bg-ochre/10 text-ochre']}>
        <Icon name="check" class="size-3.5" />
      </span>
      <span class:list={['leading-snug', dark ? 'text-white/85' : 'text-ink/85']}>{item}</span>
    </li>
  ))}
</ul>
